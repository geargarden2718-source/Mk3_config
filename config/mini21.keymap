#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            // SW01..SW06
            // SW07..SW12
            // SW13..SW18
            //               SW19 SW20 SW21
            bindings = <
                &kp Q    &kp W    &kp E    &kp R    &kp T    &kp Y
                &kp A    &kp S    &kp D    &kp F    &kp G    &kp H
                &kp Z    &kp X    &kp C    &kp V    &kp B    &kp N
                                            &kp SPACE &kp RET &lt 1 ESC
            >;
        };
        bluetooth_layer {
            // Hold SW21 (Fn) and tap SW1-SW5 to select BLE profiles 1-5.
            // Hold SW21 and tap SW6 to clear the selected profile bond.
            bindings = <
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR
                &kp N1      &kp N2      &kp N3      &kp N4      &kp N5      &kp N6
                &kp F1      &kp F2      &kp F3      &kp F4      &kp F5      &kp F6
                                                     &trans     &trans     &trans
            >;
        };
    };
};
