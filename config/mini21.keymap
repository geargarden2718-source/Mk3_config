#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        fn_base: fn_base {
            compatible = "zmk,behavior-hold-tap";
            label = "FN_BASE";
            bindings = <&mo>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    macros {
        icloud: icloud {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2 &kp M &kp A &kp S &kp A &kp T &kp O &kp PERIOD &kp NUMBER_2 &kp N7 &kp NUMBER_1 &kp N8 &kp NUMBER_2 &kp LBKT &kp I &kp C &kp L &kp O &kp U &kp D &kp PERIOD &kp C &kp O &kp M>;
            label = "ICLOUD";
        };

        tmu: tmu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2 &kp T &kp A &kp K &kp E &kp U &kp C &kp H &kp I &kp MINUS &kp M &kp A &kp S &kp A &kp T &kp O &kp LBKT &kp E &kp D &kp PERIOD &kp T &kp M &kp U &kp PERIOD &kp A &kp C &kp PERIOD &kp J &kp P>;
            label = "TMU";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // SW01..SW06
            // SW07..SW12
            // SW13..SW18
            //               SW19 SW20 SW21

            bindings = <
&kp TAB    &kp Q  &kp W  &kp E      &kp R    &kp T
&kp LC(A)  &kp A  &kp S  &kp D      &kp F    &kp G
&kp LS(Z)  &kp Z  &kp X  &kp C      &kp V    &kp B
                         &kp SPACE  &kp RET  &fn_base 4 0
            >;
        };

        number {
            bindings = <
&trans         &kp SLASH  &kp N7        &kp N8        &kp N9        &kp MINUS
&kp LA(TILDE)  &kp DQT    &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp COLON
&trans         &kp N0     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD
                                        &trans        &trans        &fn_base 4 0
            >;
        };

        shortcut {
            bindings = <
&trans  &kp LG(LS(N5))  &kp LG(S)      &kp UP_ARROW  &kp LG(Z)  &kp BACKSPACE
&trans  &kp LG(LEFT)    &kp LEFT       &kp DOWN      &kp RIGHT  &kp LG(RIGHT)
&trans  &kp LG(F)       &kp LG(SPACE)  &kp LG(C)     &kp LG(V)  &kp LG(LA(LS(V)))
                                       &trans        &trans     &fn_base 4 0
            >;
        };

        macro {
            bindings = <
&trans  &trans  &trans  &trans  &tmu    &icloud
&trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &fn_base 4 0
            >;
        };

        bluetooth_layer {
            // Hold SW21 (Fn) and tap SW1-SW5 to select BLE profiles 1-5.
            // Hold SW21 and tap SW6 to clear the selected profile bond.

            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&none         &none         &none         &to 3         &to 2         &to 1
&kp F1        &kp F2        &kp F3        &kp F4        &kp LANG2     &kp LANG1
                                          &trans        &trans        &fn_base 4 0
            >;
        };
    };
};
