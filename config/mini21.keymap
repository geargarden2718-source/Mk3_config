#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        fn_base: fn_base {
            compatible = "zmk,behavior-hold-tap";
            label = "FN_BASE";
            bindings = <&mo>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // SW01..SW06
            // SW07..SW12
            // SW13..SW18
            //               SW19 SW20 SW21

            bindings = <
&kp TAB    &kp Q  &kp W  &kp E      &kp R    &kp T
&kp LC(A)  &kp A  &kp S  &kp D      &kp F    &kp G
&kp LS(Z)  &kp Z  &kp X  &kp C      &kp V    &kp B
                         &kp SPACE  &kp RET  &fn_base 1 0
            >;
        };

        bluetooth_layer {
            // Hold SW21 (Fn) and tap SW1-SW5 to select BLE profiles 1-5.
            // Hold SW21 and tap SW6 to clear the selected profile bond.

            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&kp N1        &kp N2        &kp N3        &kp N4        &kp N5        &kp N6
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5        &kp F6
                                          &trans        &trans        &trans
            >;
        };

        number {
            bindings = <
&trans         &kp SLASH     &kp N7        &kp N8        &kp N9        &kp MINUS
&kp LA(TILDE)  &kp ASTERISK  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp PLUS
&trans         &kp N0        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD
                                           &trans        &trans        &trans
            >;
        };
    };
};
